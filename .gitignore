# This repo is PUBLIC. Never commit anything from the engagement.
# Event work happens in ~/cptc-work, a copy with no .git. These entries are a second safety net
# in case someone works inside the clone by mistake. Entries starting with / apply to the repo root only.

# --- Event working folders (created in the working copy on the day) ---
/field-notes/
/incoming/
/build/
/tracker/
/report.md
/findings/*
!/findings/.gitkeep
/evidence/*
!/evidence/.gitkeep

# --- Tool exports and terminal logs (logs contain typed secrets) ---
cptc-export-*.zip
cptc-logs/
*.log

# --- Scan output and loot named in the checklists ---
*.gnmap
*.nmap
*.xml
disc-*
svc.*
live.txt
scope.txt
users.txt
relay.txt
asrep.txt
kerb.txt
ot-hosts.txt
*.hashes
*.ccache
*.kirbi
*.pfx
*bloodhound*.zip
*_computers.json
*_users.json
*_groups.json
*_domains.json

# --- Live tracker copies. The blank starters in templates/tracker/ stay tracked ---
/hosts*.csv
/credentials*.csv
/created-accounts*.csv
/attack-path*.csv
/findings-index*.csv

# --- OS and editor noise ---
.DS_Store
__pycache__/
*.pyc
*.swp

# Fake test data for tools/ must stay tracked
!tools/tests/fixtures/
!tools/tests/fixtures/**
# Test scratch folder: never tracked
tools/tests/.tmp/

# Files waiting to move out of this public repo (to the team Drive or the team repo)
_staging/

# Personal agent and editor setup: kept local, not part of the public repo
agents.md
.maestri/
.claude/settings.local.json
